# =====================================================================
# Git Ignore - Only Code Required to Run the Application
# =====================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Documentation, Readmes, Reports & Assignment Files ---
*.md
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
docs/
.superpowers/

# --- AI & Private Workspace Files ---
GEMINI.md
.gemini/
.system_generated/
scratch/
*.tmp

# --- Packaging & Build Scripts (Not required to run source code) ---
build/
dist/
*.spec
*.zip
*.7z
*.tar.gz
build_exe.bat
build_portable.py
package_app.py

# --- Heavy Portable Binaries (FFmpeg/FFprobe binaries) ---
tools/*
!tools/.gitkeep

# --- Logs, Temporary & Cache Files ---
logs/
*.log
cache/
temp/
tmp/

# --- Testing & Code Quality Caches ---
tests/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- User Media, Test Outputs & Exports ---
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.ts
*.m4v
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.opus
output/
vid test/
vid_test/
test_vid/
test_videos/
*_snapshot_*.png
*.snapshot.png

# --- Keep Application Code & Runtime Assets ---
!requirements.txt
!main.py
!src/
!assets/
!assets/*
!tools/.gitkeep

# --- OS & IDE Specific Files ---
.vscode/
.idea/
*.swp
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
