# =====================================================================
# Git Ignore - Chỉ Giữ Những Gì Cần Thiết Để Chạy Ứng Dụng
# =====================================================================

# --- 1. Python & Môi Trường Ảo ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.eggs/

# --- 2. Tài Liệu, README & Hướng Dẫn (Không đưa lên GitHub) ---
[Rr][Ee][Aa][Dd][Mm][Ee]*
[Hh][Dd][Ss][Dd]*
*.md
*.txt
!requirements.txt

# --- 3. Đóng Gói & Xuất Bản (Chỉ dùng tạo bản build, không để chạy app) ---
build/
dist/
*.spec
*.zip
*.7z
*.tar.gz
*.rar
package_*.py
build_*.bat
build_portable.py
package_app.py
build_exe.bat
package_release.py
build_release.bat

# --- 4. File Nhị Phân Lớn & Thư Viện Portable (Tránh vượt quá giới hạn 100MB của GitHub) ---
*.exe
*.dll
*.so
*.dylib
*.bin
tools/*
!tools/.gitkeep

# --- 5. Báo Cáo, Xuất Bản & Văn Bản Office ---
*.html
*.htm
*_files/
BAO_CAO*
SO_SANH*
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
docs/

# --- 6. Cấu Hình Riêng & AI Workspace ---
GEMINI.md
Compressed
.gemini/
.system_generated/
.superpowers/
scratch/
*.tmp
*.bak

# --- 7. Logs & Bộ Nhớ Tạm (Cache) ---
logs/
*.log
cache/
temp/
tmp/

# --- 8. File Kiểm Thử & Đo Đạc (Tests) ---
tests/
test_*.py
inspect_*.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- 9. Video, Âm Thanh & Ảnh Chụp Màn Hình Của Người Dùng ---
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.ts
*.m4v
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.opus
output/
vid test/
vid_test/
test_vid/
test_videos/
*_snapshot_*.png
*.snapshot.png

# --- 10. File Hệ Điều Hành & IDE ---
.vscode/
.idea/
*.swp
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# =====================================================================
# Whitelist - CHỈ GIỮ ĐÚNG CÁC TỆP CẦN THIẾT ĐỂ CHẠY ỨNG DỤNG
# =====================================================================
!requirements.txt
!main.py
!run.bat
!src/
!src/**
!assets/
!assets/**
!tools/.gitkeep
