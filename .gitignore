# =====================================================================
# Git Ignore for Lossless Video Cutter (PySide6 + FFmpeg)
# =====================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Documentation, README, and AI pair-programming files (Only code in repo)
*.md
docs/
.gemini/
.system_generated/

# Project caches and logs
cache/
logs/
*.log

# Temporary and scratch folders
scratch/
temp/
tmp/

# Heavy portable binaries (Do not upload 100MB+ executables to GitHub)
tools/*.exe
tools/ffmpeg
tools/ffprobe
!tools/.gitkeep

# PyInstaller / Packaging build outputs
build/
dist/
*.spec
*.zip

# Test and temporary media outputs in project root and test folders
vid test/
vid_test/
test_vid/
test_videos/
*.mp4
*.mkv
*.mov
*.avi
*.ts
*.webm
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
output/

# Testing and linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
