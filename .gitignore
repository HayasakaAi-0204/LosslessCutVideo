# =====================================================================
# Git Ignore for Lossless Video Cutter (PySide6 + FFmpeg)
# =====================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Packaging & Distribution ---
build/
dist/
*.spec
*.egg-info/
*.egg
*.whl
*.zip
*.7z
*.tar.gz

# --- Heavy Portable Binaries (Never commit 100MB+ binaries to Git) ---
tools/*
!tools/.gitkeep

# --- AI & Private Workspace Files ---
GEMINI.md
.gemini/
.system_generated/
*.tmp
scratch/

# --- Logs, Temporary & Cache Files ---
logs/
*.log
cache/
temp/
tmp/

# --- Testing & Code Quality Caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- User Media, Test Outputs & Exports (Never upload user videos to Git) ---
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.ts
*.m4v
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.opus
output/
vid test/
vid_test/
test_vid/
test_videos/
*_snapshot_*.png
*.snapshot.png

# --- Keep Essential Project Assets & Documentation ---
!assets/
!assets/*
!README.md

# --- OS & IDE Specific Files ---
.vscode/
.idea/
*.swp
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
