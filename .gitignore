# =====================================================================
# Git Ignore - Only Code Required to Run the Application
# =====================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.eggs/

# --- Temporary & Inspection Scripts ---
inspect_*.py
test_*.py
!src/**

# --- Heavy Compiled Binaries & Dynamic Libraries ---
# (GitHub rejects files > 100MB; tools/ffmpeg.exe is ~138.5MB)
*.exe
*.dll
*.so
*.dylib
*.bin
tools/*
!tools/.gitkeep

# --- Packaging & Distribution (Not needed to run source code) ---
build/
dist/
*.spec
*.zip
*.7z
*.tar.gz
*.rar
build_exe.bat
build_portable.py
package_app.py

# --- Reports, Documents, HTML Exports & Notes ---
# (App is 100% PySide6, does not require HTML/Doc/Office files to run)
*.html
*.htm
*_files/
BAO_CAO*
SO_SANH*
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
docs/
*.md
!README.md
.superpowers/

# --- AI & Private Workspace Artifacts ---
GEMINI.md
.gemini/
.system_generated/
scratch/
*.tmp
*.bak

# --- Logs, Temporary & Cache Files ---
logs/
*.log
cache/
temp/
tmp/

# --- Testing & Code Quality Caches ---
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- User Media, Test Outputs & Video Exports ---
*.mp4
*.mkv
*.mov
*.avi
*.wmv
*.flv
*.webm
*.ts
*.m4v
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.opus
output/
vid test/
vid_test/
test_vid/
test_videos/
*_snapshot_*.png
*.snapshot.png

# --- OS & IDE Specific Files ---
.vscode/
.idea/
*.swp
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Whitelist: Keep Application Code & Runtime Assets ---
!requirements.txt
!main.py
!run.bat
!README.md
!src/
!src/**
!assets/
!assets/**
!tools/.gitkeep
